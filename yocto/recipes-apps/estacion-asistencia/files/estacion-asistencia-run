#!/bin/sh
# Ejecuta la estacion de asistencia sobre el escritorio virtual y la relanza si falla.
[ -r /etc/default/estacion-display ] && . /etc/default/estacion-display
export DISPLAY=:${DISPLAY_NUM:-0}
export HOME=/home/root
export PYTHONUNBUFFERED=1
LOG=/var/log/estacion-asistencia.log

PID=
trap 'kill "$PID" 2>/dev/null; exit 0' TERM INT

while true; do
    /usr/bin/python3 /opt/estacion-asistencia/main.py >> "$LOG" 2>&1 &
    PID=$!
    wait "$PID"
    [ "$?" -eq 0 ] && exit 0     # cierre normal: no relanzar
    sleep 2                      # fallo: reintentar
done
