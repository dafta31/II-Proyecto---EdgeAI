#!/bin/sh
### BEGIN INIT INFO
# Provides:          estacion-asistencia
# Required-Start:    $local_fs $network estacion-display
# Required-Stop:     $local_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Estacion de asistencia Edge AI (GUI Tkinter sobre Xvnc)
### END INIT INFO

NAME=estacion-asistencia
RUN=/usr/bin/estacion-asistencia-run
PIDFILE=/var/run/estacion-asistencia.pid

DISPLAY_NUM=0
[ -r /etc/default/estacion-display ] && . /etc/default/estacion-display
SOCKET=/tmp/.X11-unix/X$DISPLAY_NUM

en_ejecucion() {
    [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

case "$1" in
  start)
    echo -n "Iniciando $NAME: "
    if en_ejecucion; then
        echo "ya estaba en ejecucion"
        exit 0
    fi
    # Esperar al escritorio virtual (hasta 30 s)
    i=0
    while [ ! -S "$SOCKET" ] && [ "$i" -lt 30 ]; do
        sleep 1
        i=$((i + 1))
    done
    if [ ! -S "$SOCKET" ]; then
        echo "sin escritorio virtual (ver /var/log/estacion-display.log)"
        exit 1
    fi
    start-stop-daemon -S -b -m -p "$PIDFILE" -x "$RUN"
    echo "hecho"
    ;;
  stop)
    echo -n "Deteniendo $NAME: "
    start-stop-daemon -K -q -p "$PIDFILE"
    rm -f "$PIDFILE"
    echo "hecho"
    ;;
  restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;
  status)
    if en_ejecucion; then
        echo "$NAME en ejecucion (pid $(cat "$PIDFILE"))"
    else
        echo "$NAME detenido"
        exit 3
    fi
    ;;
  *)
    echo "Uso: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
exit 0
